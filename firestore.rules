rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Il claim "admin" viene assegnato solo dal server (funzione syncAdminClaim,
    // in base all'elenco ADMIN_EMAILS). Il client non può autoassegnarselo.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Campi del profilo che può modificare solo il server (Stripe/Cloud Functions) o un admin
    function protectedFields() {
      return ['plan', 'isAdmin', 'isSuspended', 'subscriptionStatus', 'autoRenew',
              'paymentHistory', 'stripeCustomerId', 'stripeSubscriptionId',
              'aiInteractionsThisMonth', 'aiUsage', 'dishUsage', 'receiptUsage', 'hadSubscription', 'tempOTP', 'tempOTPExpires', 'tempOTPGeneratedAt',
              'tempPassword', 'tempPasswordGeneratedAt',
              // Collegamento a una famiglia: lo scrive solo il server (funzioni joinFamily / leaveFamily)
              'familyId'];
    }

    // Chi si è collegato alla famiglia di ownerId con il codice: può solo consultare menù e ricette.
    // Il documento viewers/{uid} lo scrivono solo le funzioni del server.
    function isViewerOf(ownerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerId)/viewers/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Scontrino della spesa: solo negozio, data, totale (in euro) e da dove viene. La foto non si salva.
    function isValidReceipt(d) {
      return d.keys().hasAll(['store', 'date', 'total', 'createdAt'])
        && d.keys().hasOnly(['store', 'date', 'total', 'createdAt', 'source'])
        && d.store is string && d.store.size() >= 1 && d.store.size() <= 60
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.total is number && d.total > 0 && d.total <= 5000
        && d.createdAt is int
        && (!('source' in d) || d.source in ['photo', 'manual']);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['adminId', 'adminEmail', 'action', 'targetUserId', 'targetUserEmail', 'timestamp', 'details'])
        && data.keys().size() == 7
        && data.adminId is string && data.adminId.size() <= 128
        && data.adminEmail is string && data.adminEmail.size() <= 256
        && data.action is string && data.action.size() <= 128
        && data.targetUserId is string && data.targetUserId.size() <= 128
        && data.targetUserEmail is string && data.targetUserEmail.size() <= 256
        && data.timestamp == request.time
        && data.details is string && data.details.size() <= 2000;
    }

    // 2. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && !request.resource.data.keys().hasAny(protectedFields())) || isAdmin();
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields())) || isAdmin();
      allow delete: if isAdmin();
      
      // Subcollections
      match /familyMembers/{memberId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /pantry/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /mealPlans/{planId} {
        allow read, write: if isOwner(userId) || isAdmin();
        // Menù condiviso: i familiari collegati lo leggono soltanto
        allow read: if isViewerOf(userId);
      }

      match /customRecipes/{recipeId} {
        allow read, write: if isOwner(userId) || isAdmin();
        // Servono per mostrare i piatti scritti dalla famiglia nel menù condiviso
        allow read: if isViewerOf(userId);
      }

      // Persone collegate alla famiglia: le vede chi gestisce e ognuno vede solo sé stesso. Le scrive solo il server.
      match /viewers/{viewerUid} {
        allow read: if isOwner(userId) || isAdmin() || (isSignedIn() && request.auth.uid == viewerUid);
        allow write: if false;
      }

      // Codice di condivisione in chiaro: solo per chi gestisce (per rimandarlo). Lo scrive solo il server.
      match /familyShare/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      match /favorites/{recipeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /voiceShoppingItems/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /vacationPlan/{planId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /shoppingList/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Scontrini: li vede e li modifica solo chi li ha caricati
      match /receipts/{receiptId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin()) && isValidReceipt(request.resource.data);
      }
    }

    // 3. Recipes (Global - Read only for authenticated users)
    match /recipes/{recipeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAuditLog(request.resource.data);
      allow update, delete: if false; // Logs must be append-only
    }
    
    // Testing connection doc
    match /test/connection {
      allow read: if true;
    }
  }
}
